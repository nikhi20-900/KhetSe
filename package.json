{
  "name": "khetse",
  "version": "0.1.0",
  "private": true,
  "description": "Software-only agricultural harvest logistics coordination platform (Scaffold)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run && npm run demo:validate && npm run docs:check",
    "demo": "node scripts/demo.mjs",
    "demo:validate": "node scripts/validate-demo.mjs",
    "docs:generate": "node scripts/render-docs.mjs",
    "docs:check": "node scripts/render-docs.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-scaffold": "node scripts/validate-scaffold.mjs",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
